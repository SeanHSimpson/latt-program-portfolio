{
  "name": "LATT Enterprise",
  "dataColors": [
    "#1D4ED8",
    "#0284C7",
    "#0F2942",
    "#059669",
    "#CA8A04",
    "#EA580C",
    "#7C3AED",
    "#94A3B8",
    "#DC2626",
    "#0D9488"
  ],
  "background": "#FFFFFF",
  "foreground": "#1E293B",
  "tableAccent": "#1D4ED8",
  "good": "#16A34A",
  "neutral": "#CA8A04",
  "bad": "#DC2626",
  "maximum": "#1D4ED8",
  "center": "#93C5FD",
  "minimum": "#EFF6FF",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#FFFFFF"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#0F2942"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#1E293B"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 32,
      "color": "#0F2942"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#BFD3EA"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight",
            "color": {
              "solid": {
                "color": "#0F2942"
              }
            },
            "transparency": 85
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#0F2942"
              }
            },
            "fontSize": 12,
            "alignment": "left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#E6EDF5"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E6EDF5"
              }
            },
            "transparency": 0
          }
        ],
        "wallpaper": [
          {
            "color": {
              "solid": {
                "color": "#E6EDF5"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#EFF6FF"
              }
            },
            "transparency": 0
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0F2942"
              }
            },
            "fontSize": 32,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1D4ED8"
              }
            },
            "fontSize": 14
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1D4ED8"
              }
            },
            "radius": 12,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight",
            "color": {
              "solid": {
                "color": "#0F2942"
              }
            },
            "transparency": 70
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#EFF6FF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1D4ED8"
              }
            },
            "radius": 12,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight",
            "color": {
              "solid": {
                "color": "#0F2942"
              }
            },
            "transparency": 70
          }
        ],
        "accentBar": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1D4ED8"
              }
            },
            "position": "Left",
            "width": 6
          }
        ],
        "value": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F2942"
              }
            },
            "fontSize": 32,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "label": [
          {
            "fontColor": {
              "solid": {
                "color": "#1D4ED8"
              }
            },
            "fontSize": 14
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F2942"
              }
            },
            "background": {
              "solid": {
                "color": "#DBEAFE"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#0F2942"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 11,
            "bold": true
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F2942"
              }
            },
            "fontSize": 11,
            "bold": true
          }
        ],
        "values": [
          {
            "fontSize": 11,
            "backColorSecondary": {
              "solid": {
                "color": "#F1F6FC"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#0F2942"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "wordWrap": true,
            "backColorSecondary": {
              "solid": {
                "color": "#F1F6FC"
              }
            }
          }
        ]
      }
    }
  }
}