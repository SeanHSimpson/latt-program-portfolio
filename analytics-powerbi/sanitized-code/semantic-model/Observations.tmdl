	/// How LATT responded to each deficiency. The three below are mutually exclusive and add up to [Deficiencies].
	/// 1) Flagged for staff action (brought back to the MAJCOM staff). Takes precedence over training.
	measure 'Brought Back for Staff Action' = ```
			
			        CALCULATE ( [Deficiencies], KEEPFILTERS ( Observations[Staff Action] = TRUE () ) )
			```
		formatString: 0
		lineageTag: 6ebfa05b-8c74-4dc9-b13f-4f5e6d7c8b99

	/// 2) The team trained on site (and it was not brought back for staff action).
	measure 'Provided Training' = ```
			
			        CALCULATE ( [Training Opportunities Taken], KEEPFILTERS ( Observations[Staff Action] = FALSE () ) )
			```
		formatString: 0
		lineageTag: 7fc0b16c-9d85-4eda-c240-505f7e8d9caa

	/// 3) Everything else: the team left a written recommendation for the unit to act on.
	measure 'Recommendation to Unit' = [Deficiencies] - [Brought Back for Staff Action] - [Provided Training]
		formatString: 0
		lineageTag: 80d1c27d-ae96-4feb-d351-61608f9eadbb

