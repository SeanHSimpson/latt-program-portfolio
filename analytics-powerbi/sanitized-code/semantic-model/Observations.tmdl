	/// Text such as "9 of 12": root-cause categories that appeared at every assessment in the current selection.
	measure 'Root Causes at Every LATT' = ```
			
			        VAR n =
			            CALCULATE ( DISTINCTCOUNT ( Observations[Assessment] ), KEEPFILTERS ( Observations[Is Positive] = FALSE () ) )
			        VAR types =
			            CALCULATETABLE (
			                VALUES ( Observations[Finding Type] ),
			                KEEPFILTERS ( Observations[Is Positive] = FALSE () ),
			                KEEPFILTERS ( Observations[Finding Type] <> "Not Classified" )
			            )
			        VAR everywhere =
			            FILTER (
			                types,
			                CALCULATE ( DISTINCTCOUNT ( Observations[Assessment] ), KEEPFILTERS ( Observations[Is Positive] = FALSE () ) ) = n
			            )
			        RETURN
			            IF ( n > 1, COUNTROWS ( everywhere ) & " of " & COUNTROWS ( types ) )
			```
		lineageTag: e52c270b-14d6-43b3-5f8a-96b7f4e3820b

	/// Cell count for the recurrence heat map (0 instead of blank so gaps show).
	measure 'Recurrence Count' = COALESCE ( [Deficiencies], 0 )
		formatString: 0
		lineageTag: f63d381c-25e7-44c4-609b-a7c805f4931c

	measure 'Recurrence Color' = ```
			
			        VAR c = [Recurrence Count]
			        RETURN
			            SWITCH ( TRUE (), c = 0, "#FFFFFF", c <= 2, "#DBEAFE", c <= 5, "#BFDBFE", c <= 9, "#93C5FD", "#60A5FA" )
			```
		lineageTag: 074e492d-36f8-45d5-71ca-b8d916a5042d

	/// Running total of training opportunities across assessments in date order (ASMT-001, ASMT-002, ...).
	measure 'Training Running Total' = ```
			
			        VAR cur = MAX ( Observations[Assessment] )
			        RETURN
			            CALCULATE (
			                [Training Opportunities Taken],
			                FILTER ( ALLSELECTED ( Observations[Assessment] ), Observations[Assessment] <= cur )
			            )
