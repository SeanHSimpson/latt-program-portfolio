	measure 'Pareto Share' = DIVIDE ( [Classified Deficiencies], [Pareto Total] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 33331f51-7d2f-48db-964c-1da568a469a4

	measure 'Pareto Cumulative %' = ```
			
			        VAR CurName = SELECTEDVALUE ( Observations[Finding Type] )
			        VAR CurCnt = [Classified Deficiencies]
			        VAR Tbl =
			            ADDCOLUMNS ( ALLSELECTED ( Observations[Finding Type] ), "@c", [Classified Deficiencies] )
			        VAR Cum =
			            SUMX (
			                FILTER ( Tbl, [@c] > CurCnt || ( [@c] = CurCnt && Observations[Finding Type] <= CurName ) ),
			                [@c]
			            )
			        RETURN
			            IF ( CurCnt > 0, DIVIDE ( Cum, [Pareto Total] ) )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5a033970-fc91-414b-a67e-4dec7e4f53f3

	measure 'Pareto Core' = ```
			
			        IF ( NOT ISBLANK ( [Pareto Cumulative %] ), IF ( [Pareto Cumulative %] - [Pareto Share] < 0.8, 1, 0 ) )
			```
		formatString: 0
		lineageTag: 9879208a-dbc6-4dbc-a07b-0977a2d0c8be

	measure 'Pareto Bar Color' = IF ( [Pareto Core] = 1, "#1D4ED8", "#94A3B8" )
