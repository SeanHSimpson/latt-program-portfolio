	/// Deficiencies where the team logged a training or corrective action: any real entry in the
	/// Training/Corrective Action block counts (blank, N/A, NA and None do not).
	measure 'Training Opportunities Taken' = ```
			
			        CALCULATE (
			            [Deficiencies],
			            KEEPFILTERS (
			                FILTER (
			                    ALL ( Observations[Corrective Action] ),
			                    LEN ( TRIM ( Observations[Corrective Action] ) ) > 0
			                        && NOT Observations[Corrective Action] IN { "N/A", "NA", "None" }
			                )
			            )
			        )
			```
		formatString: 0
		lineageTag: 90d372b6-cf81-4e6e-0a35-41620bfe3d56

	measure 'Training Opportunities Taken %' = DIVIDE ( [Training Opportunities Taken], [Deficiencies] )
		formatString: 0%;-0%;0%
		lineageTag: b2f594d8-e1a3-4080-2c57-6384d1b05f78

	/// Something was logged in Training/Corrective Action and it reads as a recommendation or action for the unit to follow up on.
	measure 'Recommended Follow-Up' = ```
			
			        CALCULATE (
			            [Deficiencies],
			            KEEPFILTERS (
			                FILTER (
			                    ALL ( Observations[Corrective Action] ),
			                    LEN ( TRIM ( Observations[Corrective Action] ) ) > 0
			                        && NOT Observations[Corrective Action] IN { "N/A", "NA", "None" }
			                )
			            )
			        ) - [Training Opportunities Taken]
			```
		formatString: 0
		lineageTag: a1e483c7-d092-4f7f-1b46-5273c0af4e67

	measure 'Priority Items Trained On' = ```
			
			        CALCULATE ( [Training Opportunities Taken], KEEPFILTERS ( Observations[Is Priority] = TRUE () ) )
			```
		formatString: 0
