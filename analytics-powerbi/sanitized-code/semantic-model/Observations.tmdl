		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Deficiencies whose Reference names a written document (TO, AFI/DAFI/DAFMAN, supplement, AFTTP, NFPA, CFETP, etc.).
	/// Based on the Reference, not the evaluator's Compliance checkbox. Strengths are excluded via [Deficiencies].
	/// Edit the list below to add other non-document placeholders.
	measure 'Policy-Linked Findings' = ```
			
			        CALCULATE (
			            [Deficiencies],
			            KEEPFILTERS (
			                NOT Observations[Reference]
			                    IN { "Uncited", "N/A", "None", "TTPs", "Best Practice", "Safe For Maintenance", "Local accountable property" }
			            )
			        )
			```
		formatString: 0
		lineageTag: 3e1d7b52-8c4a-4f0e-9a61-5b2f7c8d9e14

	/// Deficiencies with no written-document reference: recommended improvement areas.
	measure 'Improvement Areas' = [Deficiencies] - [Policy-Linked Findings]
		formatString: 0
		lineageTag: 7a2c4e91-d3b5-4f68-8e07-1c9b6a5d3f22

	/// Share of deficiencies tied to a written document. Replaces Compliance % on the Executive Summary.
	measure 'Policy-Linked %' = DIVIDE ( [Policy-Linked Findings], [Deficiencies] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c58e0f3a-2b71-4d9c-a6e4-8f1d3b7a0c55

	measure 'Improvement Area %' = DIVIDE ( [Improvement Areas], [Deficiencies] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9d4b6f17-e0a2-4c83-b5f9-2a7e1c6d8b30

	/// ---- "SO WHAT" MEASURES (Exec Visual Options page) ----
	/// Root causes a wing can correct with its own people and authority.
	measure Wing-Owned = ```
			
			        CALCULATE (
			            [Deficiencies],
			            KEEPFILTERS (
			                Observations[Finding Type]
			                    IN {
			                        "Process Exists but Not Followed", "Oversight/Supervision Gap",
			                        "Documentation/Record Integrity Failure", "Training/Qualification Gap",
			                        "Tool/Equip Accountability Failure", "Roles/Responsibilities Unclear",
			                        "Safety/Risk Controls Inadequate", "Access/Authorization Control Failure"
			                    }
			            )
			        )
			```
		formatString: 0
		lineageTag: 4b8e2d61-7a3c-4f19-b5e0-9c1d6a2f8e01

	/// Root causes that need resources or support from outside the wing (MAJCOM, depot, contractor, CE).
	measure 'Needs Outside Help' = ```
			
			        CALCULATE (
			            [Deficiencies],
			            KEEPFILTERS (
			                Observations[Finding Type]
			                    IN { "Resource/Capacity Shortfall", "External Dependency Constraint", "System/Software Limitation" }
			            )
			        )
			```
		formatString: 0
		lineageTag: 5c9f3e72-8b4d-4a2a-c6f1-0d2e7b3a9f12

	/// No defined process exists: a guidance gap (local OI or higher-level guidance).
	measure 'Guidance Gap' = ```
			
			        CALCULATE ( [Deficiencies], KEEPFILTERS ( Observations[Finding Type] = "Process Not Defined" ) )
			```
		formatString: 0
		lineageTag: 6da04f83-9c5e-4b3b-d702-1e3f8c4b0a23

	measure 'Wing-Owned %' = DIVIDE ( [Wing-Owned], [Deficiencies] )
