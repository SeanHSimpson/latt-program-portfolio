table StaffActions
	lineageTag: e7bde145-b9fb-4eb0-8f58-545aebe04032

	measure 'Tracked Actions' = COUNTROWS ( StaffActions ) + 0
		formatString: 0
		lineageTag: 292aee61-1c55-4d0d-ace5-4341fc7d5db0

	measure 'Open Actions' = ```
			
			        CALCULATE ( COUNTROWS ( StaffActions ), KEEPFILTERS ( StaffActions[Closed] = FALSE () ) ) + 0
			```
		formatString: 0
		lineageTag: 783ae8ba-dba7-4d4e-a783-3705a05c5783

	measure 'Closed Actions' = ```
			
			        CALCULATE ( COUNTROWS ( StaffActions ), KEEPFILTERS ( StaffActions[Closed] = TRUE () ) ) + 0
			```
		formatString: 0
		lineageTag: 77a0db82-0336-4458-8f28-ba3d79ab9601

	measure 'Closed %' = DIVIDE ( [Closed Actions], [Tracked Actions] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ecf3002e-ccc5-4d19-81e9-75611c959f66

	measure 'Awaiting First Update' = ```
			
			        CALCULATE ( COUNTROWS ( StaffActions ), KEEPFILTERS ( StaffActions[Update Status] = "Awaiting First Update" ) ) + 0
			```
		formatString: 0
		lineageTag: 0983c709-7703-44b0-8ea7-f8849dc31b6c

	measure 'Stale Actions' = ```
			
			        CALCULATE ( COUNTROWS ( StaffActions ), KEEPFILTERS ( StaffActions[Update Status] = "Stale (30+ Days)" ) ) + 0
			```
		formatString: 0
		lineageTag: ca95bb74-658d-4574-9197-e1a077df0a77

	measure 'Unassigned Actions' = ```
			
			        CALCULATE ( [Open Actions], KEEPFILTERS ( StaffActions[Office Symbol] = "Unassigned" ) ) + 0
			```
		formatString: 0
		lineageTag: 795b11c6-d4aa-42dd-b9ab-f071d1f1439e

	measure 'Uncategorized Actions' = ```
			
			        CALCULATE ( [Open Actions], KEEPFILTERS ( StaffActions[Category] = "Not Categorized" ) ) + 0
			```
		formatString: 0
		lineageTag: 80c8dfaf-fa33-4ebe-9f1b-dfa00cc0fb57

	measure 'Overdue Actions' = ```
			
			        CALCULATE ( COUNTROWS ( StaffActions ), KEEPFILTERS ( StaffActions[Due Status] = "Overdue" ) ) + 0
			```
		formatString: 0
		lineageTag: 70150110-3d47-4314-90db-d1411069a495

	measure 'Due in 30 Days' = ```
			
			        CALCULATE ( COUNTROWS ( StaffActions ), KEEPFILTERS ( StaffActions[Due Status] = "Due in 30 Days" ) ) + 0
			```
		formatString: 0
		lineageTag: da61032d-41ac-49a4-a6a3-1999537e352e

	measure 'Avg Days Open' = AVERAGE ( StaffActions[Days Open] )
		formatString: 0
		lineageTag: d4a62aac-9ae0-4c73-a2a9-61fe0c1a3a8c

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Not Yet in Tracker' = ```
			
			        MAX (
			            0,
			            CALCULATE ( [Staff Action Items], REMOVEFILTERS () )
			                - CALCULATE ( COUNTROWS ( StaffActions ), REMOVEFILTERS () )
			        )
			```
		formatString: 0
		lineageTag: da9c4691-03e7-4035-9bb1-b7e82b435c12

	measure 'Due Status Color' = ```
			
			        SWITCH (
			            SELECTEDVALUE ( StaffActions[Due Status] ),
			            "Overdue", "#FECACA",
			            "Due in 30 Days", "#FEF08A",
			            "On Track", "#BBF7D0",
			            "No Target Date", "#E2E8F0",
			            "Closed", "#F1F5F9"
			        )
			```
		lineageTag: 3dbfe420-e17b-4080-9578-f0f672747c1b

	measure 'Update Status Color' = ```
			
			        SWITCH (
			            SELECTEDVALUE ( StaffActions[Update Status] ),
			            "Awaiting First Update", "#FED7AA",
			            "Stale (30+ Days)", "#FEF08A",
			            "Current", "#BBF7D0",
			            "Closed", "#F1F5F9"
			        )
			```
		lineageTag: 537663cd-66c8-4bb3-b9ed-420cfebf757f

	measure 'BLUF 4 Staff Actions' = ```
			
			        FORMAT ( [Tracked Actions], "#,0" ) & " staff action items tracked: "
			            & FORMAT ( [Open Actions], "#,0" ) & " open, "
			            & FORMAT ( [Overdue Actions], "#,0" ) & " past target date, "
			            & FORMAT ( [Awaiting First Update], "#,0" ) & " awaiting a first POC update, "
			            & FORMAT ( [Unassigned Actions], "#,0" ) & " with no office assigned."
			```
		lineageTag: de0d70fb-4f2c-454d-b987-d24c4f345d68

