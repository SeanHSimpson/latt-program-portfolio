model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SiteUrl","ObservationsListName","StaffActionsListName","StaffActionsListUrlName","fnCleanText","fnSanitize","fnToBool","fnToDate","fnPublications","Observations","ThemeKeywords","ObservationThemes","ObservationReferences","Date","StaffActionsSiteUrl","StaffActions"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table Observations
ref table ObservationThemes
ref table ObservationReferences
ref table Date
ref table StaffActions

ref cultureInfo en-US

